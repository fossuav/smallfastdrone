# Native SITL approximation of the Rise255 (SmallFastDrone) high-performance
# quad, for realistic aerobatic testing without RealFlight. Based on the 5"
# freestyle model; the drag (refSpd/refAngle) and prop expo are calibrated to
# the RealFlight Rise255 logs (25.4 m/s cruise at ~24 deg lean = low drag) and
# the realflight-Rise255 params (hover 0.125, MOT_THST_EXPO 0.58).

{
    # total vehicle mass in kg
    "mass" : 0.8,

    # vehicle diameter
    "diagonal_size" : 0.25,

    # ref parameters calibrated against the RealFlight characterisation flight
    # (RealFlightModelCharacterise): at ~24 deg lean the RealFlight model holds
    # ~17 m/s, so refSpd is pulled down from the earlier 25.4 cruise estimate to
    # add drag. Hover already matches (native hover motor PWM ~1223 vs RealFlight
    # ~1200); refCurrent/refVoltage only set the battery power model, not the
    # thrust scale (they cancel in SIM_Frame's velocity_max/disc_area).
    "refSpd" : 21.0,    # m/s
    "refAngle" : 24.0,  # degrees
    "refVoltage" : 23.2, # volts
    "refCurrent" : 5, # Amps
    "refAlt" : 607,       # meters AMSL
    "refTempC" : 25,     # degrees C
    "refBatRes" : 0.0226, # BAT.Res from log

    # full battery voltage (6S)
    "maxVoltage" : 25.2,

    # full battery capacity, Ah (0 = unlimited)
    "battCapacityAh" : 0,

    # MOT_THST_EXPO (from realflight-Rise255 params)
    "propExpo" : 0.58,

    # approximate maximum yaw rate in deg/sec
    "refRotRate" : 700,

    # Per-motor yaw torque factor (CCW +, CW -), scaled up from the +-1 default to
    # calibrate the yaw authority to the real airframe. The native model ties yaw torque
    # to thrust (rotor_torque = 0.05*diagonal*motor_thrust*yaw_factor, SIM_Motor.cpp), so
    # at low throttle it under-yaws ~4x: the default gave 167 dps where the RealFlight and
    # real Marmott do 679 dps at 0.059 throttle upright (log 00000142). x4 matches it.
    # yaw_factor scales only the yaw axis; thrust and roll/pitch (position % thrust) are
    # untouched. Motor order is quad_x: 1,2 CCW / 3,4 CW.
    "motor1_yaw" : 4.0,
    "motor2_yaw" : 4.0,
    "motor3_yaw" : -4.0,
    "motor4_yaw" : -4.0,

    # hover throttle from 0 to 1 (T/W ~8)
    "hoverThrOut" : 0.125,

    # MOT_PWM_MIN / MOT_PWM_MAX
    "pwmMin" : 1000,
    "pwmMax" : 2000,

    # MOT_SPIN_MIN / MOT_SPIN_MAX
    "spin_min" : 0.01,
    "spin_max" : 0.95,

    # maximum motor slew rate, or zero to disable
    "slew_max" : 0,

    # total effective disc area in sq m for 4 x 5 inch diameter rotors
    "disc_area" : 0.204,

    # momentum drag coefficient
    "mdrag_coef" : 0.10,

    # number of motors
    "num_motors" : 4
}
